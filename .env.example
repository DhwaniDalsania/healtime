# Backend Server Port (Default: 5000)
PORT=5000

# MongoDB Connection String (Required)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/healtime
MONGODB_URI=

# 32-byte Encryption Key (64-char Hex String) for AES-256-GCM message encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAT_ENCRYPTION_KEY=
